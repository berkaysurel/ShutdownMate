<ui:FluentWindow
    x:Class="ShutdownMate.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ShutdownMate.Controls"
    Title="{DynamicResource Main_Shutdownmate}"
    Width="540"
    Height="880"
    MinHeight="560"
    ResizeMode="CanMinimize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Icon="pack://application:,,,/Assets/ShutdownMate.ico">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Koşul kartı (İşler bitince modu) -->
        <Style x:Key="ConditionCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!-- Sayaç ekranındaki durum etiketi -->
        <Style x:Key="MetricChip" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="{DynamicResource Main_Shutdownmate}" Grid.Row="0" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/ShutdownMate.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ======================= KURULUM EKRANI ======================= -->
        <Grid x:Name="SetupView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0,24,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HomeTitle" FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Main_YeniZamanlayici}" />
                    <TextBlock x:Name="LastRunText" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" HorizontalAlignment="Left" />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Transparent" Content="{DynamicResource Main_Ayarlar}" Icon="{ui:SymbolIcon Settings24}" ToolTip="{DynamicResource Main_UygulamaAyarlari}" Click="OpenPreferences_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,0,24,16">

                    <!-- Ne yapılsın -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_NeYapilsin}" />
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="ActionShutdown" Margin="0,0,3,0" ToolTip="{DynamicResource Main_BilgisayariKapatir}" GroupName="Action" Style="{StaticResource SelectionCard}" Checked="Selection_Changed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Power24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Kapat}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ActionRestart" Margin="3,0" ToolTip="{DynamicResource Main_BilgisayariYenidenBaslatir}" GroupName="Action" Style="{StaticResource SelectionCard}" Checked="Selection_Changed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_YenidenBaslat}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ActionSleep" Margin="3,0" ToolTip="{DynamicResource Main_BilgisayariUyuturAcikIsler}" GroupName="Action" Style="{StaticResource SelectionCard}" Checked="Selection_Changed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Uyku}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ActionHibernate" Margin="3,0,0,0" GroupName="Action" Style="{StaticResource SelectionCard}" Checked="Selection_Changed" ToolTipService.ShowOnDisabled="True">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Snooze24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_HazirdaBeklet}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- Ne zaman -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_NeZaman}" />
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="ModeDuration" Margin="0,0,3,0" ToolTip="{DynamicResource Main_BelirlediginizSureDoluncaIsl}" GroupName="Mode" Style="{StaticResource SelectionCard}" Checked="Selection_Changed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Timer24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_SureSonra}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeClock" Margin="3,0" ToolTip="{DynamicResource Main_SectiginizSaatteIslemYapilir}" GroupName="Mode" Style="{StaticResource SelectionCard}" Checked="Selection_Changed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Clock24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_BelirliSaatte}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeActivity" Margin="3,0,0,0" ToolTip="{DynamicResource Main_SectiginizIslerBitinceIslem}" GroupName="Mode" Style="{StaticResource SelectionCard}" Checked="Selection_Changed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_IslerBitince}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- Mod ayrıntıları -->
                    <Border Margin="0,8,0,0" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <!-- Süre -->
                            <StackPanel x:Name="DurationPanel">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <controls:TimeSpinner x:Name="DurationHours" Width="120" Minimum="0" Maximum="24" Step="1" LargeStep="5" Label="{DynamicResource Main_Saat}" ValueChanged="Spinner_Changed" />
                                    <TextBlock Margin="14,0,14,24" VerticalAlignment="Center" FontSize="40" FontWeight="Light" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text=":" />
                                    <controls:TimeSpinner x:Name="DurationMinutes" Width="120" ToolTip="{DynamicResource Main_FareTekerlegiOkTuslari}" Minimum="0" Maximum="59" Step="5" LargeStep="15" Label="{DynamicResource Main_Dakika}" ValueChanged="Spinner_Changed" />
                                </StackPanel>
                                <WrapPanel x:Name="QuickDurationsPanel" Margin="0,16,0,-8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Saat -->
                            <StackPanel x:Name="ClockPanel" Visibility="Collapsed">
                                <UniformGrid Margin="0,0,0,12" Columns="2">
                                    <RadioButton x:Name="ClockToday" Margin="0,0,3,0" ToolTip="{DynamicResource Main_IslemBugunSectiginizSaatte}" GroupName="ClockDay" Style="{StaticResource SelectionCard}" Checked="ClockDay_Changed">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Bugun}" />
                                    </RadioButton>
                                    <RadioButton x:Name="ClockTomorrow" Margin="3,0,0,0" ToolTip="{DynamicResource Main_IslemYarinSectiginizSaatte}" GroupName="ClockDay" Style="{StaticResource SelectionCard}" Checked="ClockDay_Changed">
                                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Yarin}" />
                                    </RadioButton>
                                </UniformGrid>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <controls:TimeSpinner x:Name="ClockHour" Width="120" ToolTip="{DynamicResource Main_FareTekerlegiOkTuslari}" Minimum="0" Maximum="23" Step="1" LargeStep="3" Label="{DynamicResource Main_Saat}" ValueChanged="Spinner_Changed" BeyondMaximum="ClockHour_BeyondMaximum" BeyondMinimum="ClockHour_BeyondMinimum" />
                                    <TextBlock Margin="14,0,14,24" VerticalAlignment="Center" FontSize="40" FontWeight="Light" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text=":" />
                                    <controls:TimeSpinner x:Name="ClockMinute" Width="120" ToolTip="{DynamicResource Main_FareTekerlegiOkTuslari}" Minimum="0" Maximum="59" Step="5" LargeStep="15" Label="{DynamicResource Main_Dakika}" ValueChanged="Spinner_Changed" />
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Caption}" Text="{DynamicResource Main_EnErkenSaatAyarlar}" />
                            </StackPanel>

                            <!-- İşler bitince -->
                            <StackPanel x:Name="ActivityPanel" Visibility="Collapsed">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{DynamicResource Main_SectiginizIslerBittigindeIsl}" />
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Content="{DynamicResource Main_Programlar}" ToolTip="{DynamicResource Main_AcikProgramListesiniYenile}" Click="RefreshProcesses_Click" />
                                </Grid>

                                <!-- Ağ -->
                                <Border x:Name="CondNetworkCard" Style="{StaticResource ConditionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <CheckBox x:Name="UseNetworkCheck" ToolTip="{DynamicResource Main_VeriAktarimiBelirlenenHizin}" Content="{DynamicResource Main_IndirmeYukleme}" Checked="Condition_Changed" Unchecked="Condition_Changed" />
                                            <TextBlock x:Name="NetworkLiveText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <StackPanel x:Name="NetworkOptions" Margin="28,6,0,0">
                                            <ComboBox x:Name="NetworkDirectionCombo" HorizontalAlignment="Left" MinWidth="200" ToolTip="{DynamicResource Main_HangiYondekiVeriAktariminin}" SelectionChanged="Combo_Changed">
                                                <ComboBoxItem Content="{DynamicResource Main_IndirmeVeYukleme}" />
                                                <ComboBoxItem Content="{DynamicResource Main_YalnizcaIndirme}" />
                                                <ComboBoxItem Content="{DynamicResource Main_YalnizcaYukleme}" />
                                            </ComboBox>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Hiz}" />
                                                <ui:NumberBox x:Name="NetworkThreshold" Width="130" ToolTip="{DynamicResource Main_HizBuDegerinAltinda}" Minimum="1" Maximum="100000" MaxDecimalPlaces="0" SmallChange="10" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_KbSnAltinaDusunce}" />
                                            </DockPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Olculecek}" />
                                                <ComboBox x:Name="NetworkProgramCombo" Grid.Column="1" DisplayMemberPath="Display" SelectionChanged="ProgramCombo_Changed" ToolTip="{DynamicResource Main_BirProgramSecersenizYalnizca}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- İşlemci -->
                                <Border x:Name="CondCpuCard" Style="{StaticResource ConditionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <CheckBox x:Name="UseCpuCheck" ToolTip="{DynamicResource Main_IslemciKullanimiBelirlenenOr}" Content="{DynamicResource Main_IslemciRenderDisaAktarma}" Checked="Condition_Changed" Unchecked="Condition_Changed" />
                                            <TextBlock x:Name="CpuLiveText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <StackPanel x:Name="CpuOptions" Margin="28,6,0,0">
                                            <WrapPanel>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Kullanim}" />
                                                <ui:NumberBox x:Name="CpuThreshold" Width="120" ToolTip="{DynamicResource Main_IslemciKullanimiBuOranin}" Minimum="1" Maximum="90" MaxDecimalPlaces="0" SmallChange="5" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Main_AltinaDusunce}" />
                                            </WrapPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Olculecek}" />
                                                <ComboBox x:Name="CpuProgramCombo" Grid.Column="1" DisplayMemberPath="Display" SelectionChanged="ProgramCombo_Changed" ToolTip="{DynamicResource Main_BirProgramSecersenizYalnizca2}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dosya aktarımı -->
                                <Border x:Name="CondTransferCard" Style="{StaticResource ConditionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <CheckBox x:Name="UseTransferCheck" ToolTip="{DynamicResource Main_DosyaKopyalamaTasimaYa}" Content="{DynamicResource Main_DosyaAktarimiKopyalamaYedekl}" Checked="Condition_Changed" Unchecked="Condition_Changed" ToolTipService.ShowOnDisabled="True" />
                                            <TextBlock x:Name="TransferLiveText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <StackPanel x:Name="TransferOptions" Margin="28,6,0,0">
                                            <WrapPanel>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Hiz}" />
                                                <ui:NumberBox x:Name="TransferThreshold" Width="120" ToolTip="{DynamicResource Main_AktarimHiziBuDegerin}" Minimum="1" Maximum="500" MaxDecimalPlaces="0" SmallChange="1" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Main_MbSnAltinaDusunce}" />
                                            </WrapPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Olculecek}" />
                                                <ComboBox x:Name="TransferSourceCombo" Grid.Column="1" DisplayMemberPath="Display" SelectionChanged="ProgramCombo_Changed" ToolTip="{DynamicResource Main_OtomatikAktarimBaslayincaHiz}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Ekran kartı -->
                                <Border x:Name="CondGpuCard" Style="{StaticResource ConditionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <CheckBox x:Name="UseGpuCheck" ToolTip="{DynamicResource Main_EkranKartiKullanimiBelirlene}" Content="{DynamicResource Main_EkranKartiGpuRender}" Checked="Condition_Changed" Unchecked="Condition_Changed" ToolTipService.ShowOnDisabled="True" />
                                            <TextBlock x:Name="GpuLiveText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <StackPanel x:Name="GpuOptions" Margin="28,6,0,0">
                                            <WrapPanel>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Kullanim}" />
                                                <ui:NumberBox x:Name="GpuThreshold" Width="120" ToolTip="{DynamicResource Main_EkranKartiKullanimiBu}" Minimum="1" Maximum="90" MaxDecimalPlaces="0" SmallChange="5" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Main_AltinaDusunce}" />
                                            </WrapPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource Main_Olculecek}" />
                                                <ComboBox x:Name="GpuProgramCombo" Grid.Column="1" DisplayMemberPath="Display" SelectionChanged="ProgramCombo_Changed" ToolTip="{DynamicResource Main_BirProgramSecersenizYalnizca3}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Program -->
                                <Border x:Name="CondProcessCard" Style="{StaticResource ConditionCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="UseProcessCheck" ToolTip="{DynamicResource Main_SectiginizPrograminTumPencer}" Content="{DynamicResource Main_BirProgramTamamenKapaninca}" Checked="Condition_Changed" Unchecked="Condition_Changed" />
                                        <Grid x:Name="ProcessOptions" Margin="28,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ProcessList" DisplayMemberPath="Display" ToolTip="{DynamicResource Main_KapanmasiBeklenecekProgramLi}" SelectionChanged="Combo_Changed" />
                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="{DynamicResource Main_ListeyiYenile}" Click="RefreshProcesses_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Ne zaman bitmiş sayılsın? -->
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_NeZamanBitmisSayilsin}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_SecilenIsler}" />
                                            <ui:NumberBox x:Name="CalmMinutes" Width="125" Margin="8,0" IsEnabled="{Binding IsChecked, ElementName=CalmCheck}" ToolTip="{DynamicResource Main_KisaDuraklamalarYanlisliklaB}" Minimum="1" Maximum="120" MaxDecimalPlaces="0" SmallChange="1" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_DkSakinKalirsaBitmis}" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{DynamicResource Main_RenderArasiYaDa}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="CalmCheck" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource Main_KapaliykenDegerlerEsiginAlti}" Checked="Option_Changed" Unchecked="Option_Changed" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Main_OnceIslerinBasladiginiGor}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{DynamicResource Main_SecilenIslerBirKez}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="WaitForStartCheck" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource Main_SecilenIslerBirKez2}" Checked="Option_Changed" Unchecked="Option_Changed" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_IslerBittiktenSonra}" />
                                            <ui:NumberBox x:Name="GraceMinutes" Width="125" Margin="8,0" IsEnabled="{Binding IsChecked, ElementName=GraceCheck}" ToolTip="{DynamicResource Main_IslerBitinceIslemdenOnce}" Minimum="1" Maximum="120" MaxDecimalPlaces="0" SmallChange="1" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_DkDahaBekle}" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{DynamicResource Main_IslemdenOnceTaninanEk}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="GraceCheck" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource Main_KapaliykenIslerBiterBitmez}" Checked="Option_Changed" Unchecked="Option_Changed" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_IslerBitmeseBileEn}" />
                                            <ui:NumberBox x:Name="DeadlineHours" Width="125" Margin="8,0" IsEnabled="{Binding IsChecked, ElementName=DeadlineCheck}" ToolTip="{DynamicResource Main_TakiliKalanBirIs}" Minimum="1" Maximum="72" MaxDecimalPlaces="0" SmallChange="1" ClearButtonEnabled="False" ValueChanged="Value_Changed" />
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource Main_SaatSonraUygula}" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{DynamicResource Main_TakiliKalanBirEsitleme}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="DeadlineCheck" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource Main_IslerBitmeseBileBelirlenen}" Checked="Option_Changed" Unchecked="Option_Changed" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bu zamanlayıcı için seçenekler -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_Secenekler}" />
                    <ui:CardControl x:Name="ForceCloseCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon Warning24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_AcikUygulamalariZorlaKapat}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_KaydedilmemisCalismalarKaybo}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ForceCloseToggle" ToolTip="{DynamicResource Main_UygulamalarKaydetmeSorusuSor}" />
                    </ui:CardControl>
                    <ui:CardControl Icon="{ui:SymbolIcon WeatherMoon24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_BeklerkenUyumasiniEngelle}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_WindowsGucAyarlariSayac}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PreventSleepToggle" ToolTip="{DynamicResource Main_ZamanlayiciCalisirkenWindows}" />
                    </ui:CardControl>

                    <!-- Ekran kilidi ve tam ekranda görünecek mesaj -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_EkranMesaji}" />
                    <Border Padding="16,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,60,0" Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Comment24" FontSize="20" />
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Main_EkrandaMesajGoster}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_EkranKilidindeVeTam}" />
                                    </StackPanel>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ShowMessageToggle" HorizontalAlignment="Right" ToolTip="{DynamicResource Main_MesajiEkranKilidiVe}" Checked="ShowMessage_Changed" Unchecked="ShowMessage_Changed" />
                            </Grid>
                            <CheckBox x:Name="MessageIconCheck" Margin="0,10,0,0" Content="{DynamicResource Main_MesajinUstundeIkonGoster}" ToolTip="{DynamicResource Main_MesajKutusununUstundekiUcgen}" Checked="MessageIcon_Changed" Unchecked="MessageIcon_Changed" />
                            <controls:LockMessageEditor x:Name="SetupMessageEditor" Margin="0,10,0,0" MessageChanged="LockMessage_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Alt çubuk -->
            <Border x:Name="StartBar" Grid.Row="3" Padding="24,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewSubtitle" Margin="0,2,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <ui:Button x:Name="StartButton" Grid.Column="1" MinWidth="150" Height="48" Padding="20,0" Appearance="Primary" Content="{DynamicResource Main_Baslat}" FontSize="16" FontWeight="SemiBold" Icon="{ui:SymbolIcon Play24}" ToolTip="{DynamicResource Main_ZamanlayiciyiBaslatir}" Click="Start_Click" />
                </Grid>
            </Border>

            <!-- Zamanlayıcı kurmadan kilit: çalışan zamanlayıcı çubuğuyla aynı satırı paylaşır, ikisi aynı anda görünmez -->
            <UniformGrid x:Name="IdleLockBar" Grid.Row="2" Margin="24,8,24,10" Rows="1">
                <ui:Button x:Name="IdleLockButton" Height="40" Margin="0,0,6,0" HorizontalAlignment="Stretch" Content="{DynamicResource Main_EkraniKilitle}" Icon="{ui:SymbolIcon LockClosed24}" ToolTip="{DynamicResource Main_ZamanlayiciKurmadanKilitlerB}" Click="IdleLock_Click" />
                <ui:Button Height="40" Margin="6,0,0,0" HorizontalAlignment="Stretch" Content="{DynamicResource Main_TamEkranKilidi}" Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="{DynamicResource Main_ZamanlayiciKurmadanTamEkran}" Click="IdleLock_Click" />
            </UniformGrid>

            <!-- Çalışan zamanlayıcı: durum, ardından hemen ulaşılabilir İptal Et -->
            <Border x:Name="RunningBanner" Grid.Row="2" Padding="24,14" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" BorderThickness="0,2,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Timer24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Main_ZamanlayiciCalisiyor}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="RunningBannerText" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Height="36" VerticalAlignment="Center" Appearance="Transparent" Content="{DynamicResource Main_Goster}" ToolTip="{DynamicResource Main_GeriSayimEkraniniAcar}" Click="ShowCountdown_Click" />
                    <Button Grid.Row="1" Grid.ColumnSpan="3" Height="60" Margin="0,14,0,0" HorizontalAlignment="Stretch" FontSize="19" Style="{StaticResource DangerButton}" Content="{DynamicResource Main_IptalEt}" ToolTip="{DynamicResource Main_ZamanlayiciyiDurdururIslemYa}" Click="Cancel_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= SAYAÇ EKRANI ======================= -->
        <Grid x:Name="CountdownView" Grid.Row="1" Margin="24,0,24,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <ui:Button Height="40" MinWidth="110" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Appearance="Secondary" Content="{DynamicResource Main_Geri}" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="{DynamicResource Main_KurulumEkraninaDonZamanlayic}" Click="BackToSetup_Click" />
                <ui:Button Height="40" MinWidth="110" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Appearance="Secondary" Content="{DynamicResource Main_EkraniKapat}" Icon="{ui:SymbolIcon DesktopOff24}" ToolTip="{DynamicResource Main_EkraniKapatFareYa}" Click="TurnOffDisplay_Click" />
            </Grid>

            <!-- Küçük ekranda (ör. 1366x768, %125 ölçek) halka kırpılmaz, alan kayar; yer varsa içerik ortada kalır -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <Viewbox Width="300" Height="300" HorizontalAlignment="Center">
                    <controls:CountdownDisplay x:Name="Display" />
                </Viewbox>
                <TextBlock x:Name="CountdownTarget" Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="CountdownStatus" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="WatchNote" Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed" ToolTip="{DynamicResource Main_AyarlarGecmisGozetimKaydi}">
                    <Grid>
                        <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <!-- Vurgu renkli kopya, not görünürken saydamlıktan görünüre yumuşakça gelip gider (fade in / fade out) -->
                        <ui:SymbolIcon Symbol="Eye24" FontSize="14" Opacity="0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="WatchPulse">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="WatchPulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                    <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource Main_GozetimKaydiAliniyor}" />
                </StackPanel>

                <!-- İşler bitince: koşul durumları -->
                <WrapPanel x:Name="MetricChips" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Border x:Name="ChipNetwork" Style="{StaticResource MetricChip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ChipNetworkIcon" Symbol="ArrowSwap24" FontSize="14" />
                            <TextBlock x:Name="ChipNetworkText" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipCpu" Style="{StaticResource MetricChip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ChipCpuIcon" Symbol="DeveloperBoard24" FontSize="14" />
                            <TextBlock x:Name="ChipCpuText" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipGpu" Style="{StaticResource MetricChip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ChipGpuIcon" Symbol="VideoClip24" FontSize="14" />
                            <TextBlock x:Name="ChipGpuText" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipTransfer" Style="{StaticResource MetricChip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ChipTransferIcon" Symbol="Folder24" FontSize="14" />
                            <TextBlock x:Name="ChipTransferText" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ChipProcess" Style="{StaticResource MetricChip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ChipProcessIcon" Symbol="AppGeneric24" FontSize="14" />
                            <TextBlock x:Name="ChipProcessText" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Height="60" HorizontalAlignment="Stretch" Appearance="Primary" FontSize="16" FontWeight="SemiBold" Content="{DynamicResource Main_TamEkranaGec}" Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="{DynamicResource Main_SayaciTamEkrandaGosterir}" Click="EnterFullscreen_Click" />
                <ui:Button Grid.Column="2" Height="60" HorizontalAlignment="Stretch" Appearance="Primary" FontSize="16" FontWeight="SemiBold" Content="{DynamicResource Main_EkraniKilitle}" Icon="{ui:SymbolIcon LockClosed24}" ToolTip="{DynamicResource Main_EkranGorunurKalirTiklamalar}" Click="LockScreen_Click" />
                <ui:Button x:Name="SnoozeButton" Grid.Row="2" Grid.Column="0" Height="52" FontSize="15" HorizontalAlignment="Stretch" Content="{DynamicResource Main_10DkErtele}" Icon="{ui:SymbolIcon Add24}" ToolTip="{DynamicResource Main_IslemiErtelerErtelemeSuresi}" Click="Snooze_Click" />
                <Button x:Name="CancelButton" Grid.Row="2" Grid.Column="2" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource DangerButton}" Content="{DynamicResource Main_IptalEt}" ToolTip="{DynamicResource Main_ZamanlayiciyiDurdururIslemYa}" Click="Cancel_Click" />
            </Grid>
        </Grid>

        <!-- ======================= AYARLAR EKRANI ======================= -->
        <Grid x:Name="PreferencesView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0,24,6">
                <ui:Button Height="40" MinWidth="110" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Appearance="Secondary" Content="{DynamicResource Main_Geri}" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="{DynamicResource Main_GeriDonEsc}" Click="ClosePreferences_Click" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Main_Ayarlar}" />
            </Grid>

            <!-- Sekmeler -->
            <UniformGrid Grid.Row="1" Margin="21,8,21,8" Columns="3">
                <RadioButton x:Name="PrefTabTimer" Margin="3" ToolTip="{DynamicResource Main_HizliSureDugmeleriErteleme}" GroupName="PrefTab" IsChecked="True" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Timer24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Zamanlayici}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabSecurity" Margin="3" ToolTip="{DynamicResource Main_YanlisliklaBaslatmayaVeIsten}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Guvenlik}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabAlerts" Margin="3" ToolTip="{DynamicResource Main_IslemdenOncekiUyarininZamani}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Alert24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_UyarilarVeSes}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabFullscreen" Margin="3" ToolTip="{DynamicResource Main_TamEkranGeriSayimda}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_TamEkran}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabLock" Margin="3" ToolTip="{DynamicResource Main_EkranKilidindeNelerinGorunec}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_EkranKilidi}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabAppearance" Margin="3" ToolTip="{DynamicResource Main_GostergeStiliTemaVurgu}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Color24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Kisisellestirme}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabHistory" Margin="3" ToolTip="{DynamicResource Main_BilgisayarinNeZamanKapandigi}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="History24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Gecmis}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PrefTabAbout" Margin="3" ToolTip="{DynamicResource Main_SurumGuncellemelerGizlilikKl}" GroupName="PrefTab" Style="{StaticResource SelectionCard}" Checked="PrefTab_Changed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Info24" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Hakkinda}" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <ScrollViewer x:Name="PrefScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,0,24,24">

                <!-- ======================= GÜVENLİK SEKMESİ ======================= -->
                <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_YanlisliklaBaslatmayaKarsi}" />
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Play24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_BaslatmadanOnceOnOnay}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_BaslatABasincaIslem}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PrefStartConfirm" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_EnKisaSure}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_IslemEnErkenBu}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="PrefMinLead" MinWidth="150" SelectionChanged="PreferenceCombo_Changed">
                            <ComboBoxItem Content="{DynamicResource Main_1Dakika}" Tag="1" />
                            <ComboBoxItem Content="{DynamicResource Main_2Dakika}" Tag="2" />
                            <ComboBoxItem Content="{DynamicResource Main_5Dakika}" Tag="5" />
                            <ComboBoxItem Content="{DynamicResource Main_10Dakika}" Tag="10" />
                            <ComboBoxItem Content="{DynamicResource Main_15Dakika}" Tag="15" />
                            <ComboBoxItem Content="{DynamicResource Main_30Dakika}" Tag="30" />
                            <ComboBoxItem Content="{DynamicResource Main_1Saat}" Tag="60" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon TimerOff24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_EnUzunSure}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_SureSonraModununUst}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="PrefMaxDuration" MinWidth="150" SelectionChanged="PreferenceCombo_Changed">
                            <ComboBoxItem Content="{DynamicResource Main_6Saat}" Tag="6" />
                            <ComboBoxItem Content="{DynamicResource Main_12Saat}" Tag="12" />
                            <ComboBoxItem Content="{DynamicResource Main_24Saat}" Tag="24" />
                            <ComboBoxItem Content="{DynamicResource Main_48Saat}" Tag="48" />
                            <ComboBoxItem Content="{DynamicResource Main_72Saat}" Tag="72" />
                            <ComboBoxItem Content="{DynamicResource Main_99Saat}" Tag="99" />
                        </ComboBox>
                    </ui:CardControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_IslemAninda}" />
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LockClosed24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_TamEkranVeKilitten}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_CikisDugmesininNeKadar}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="PrefExitHold" MinWidth="170" SelectionChanged="PreferenceCombo_Changed">
                            <ComboBoxItem Content="{DynamicResource Main_03Saniye}" Tag="300" />
                            <ComboBoxItem Content="{DynamicResource Main_1Saniye}" Tag="1000" />
                            <ComboBoxItem Content="{DynamicResource Main_15Saniye}" Tag="1500" />
                            <ComboBoxItem Content="{DynamicResource Main_2Saniye}" Tag="2000" />
                            <ComboBoxItem Content="{DynamicResource Main_3Saniye}" Tag="3000" />
                            <ComboBoxItem Content="{DynamicResource Main_5Saniye}" Tag="5000" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon AlertUrgent24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_KapanisUyarisiTamEkran}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_IslemdenHemenOnceEkran}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="PrefFinalAlert" MinWidth="150" SelectionChanged="PreferenceCombo_Changed">
                            <ComboBoxItem Content="{DynamicResource Main_Kapali}" Tag="0" />
                            <ComboBoxItem Content="{DynamicResource Main_15SaniyeOnce}" Tag="15" />
                            <ComboBoxItem Content="{DynamicResource Main_30SaniyeOnce}" Tag="30" />
                            <ComboBoxItem Content="{DynamicResource Main_1DakikaOnce}" Tag="60" />
                            <ComboBoxItem Content="{DynamicResource Main_2DakikaOnce}" Tag="120" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PersonClock24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_BilgisayarKullaniliyorsaIsle}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_SureDoldugundaSon1}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PrefPostponeActive" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Warning24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_ZorlaKapatmadaEkOnay}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_KaydedilmemisCalismalarKaybo2}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PrefForceConfirm" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon UsbStick24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_KapatmadanOnceUsbSuruculeri}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_KapatmaVeYenidenBaslatmadan}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PrefEjectUsb" ToolTip="{DynamicResource Main_AcikkenUsbSuruculerKapanmada}" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                    </ui:CardControl>
                </StackPanel>

                <!-- Görünüm sekmesinin üst bölümü -->
                <StackPanel x:Name="DisplayStylePanel">

                    <!-- Gösterge stili -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_GostergeStili}" />
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="StyleModern" Margin="0,0,3,0" ToolTip="{DynamicResource Main_SimgeInceRakamlarVe}" GroupName="DisplayStyle" Style="{StaticResource SelectionCard}" Checked="DisplayStyle_Checked">
                            <StackPanel>
                                <Viewbox Height="64" Margin="0,0,0,2" Stretch="Uniform" IsHitTestVisible="False"><controls:CountdownDisplay x:Name="PreviewModern" DisplayStyle="Modern" /></Viewbox>
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Modern}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StyleClassic" Margin="3,0" ToolTip="{DynamicResource Main_SaatKadraniIcindeSure}" GroupName="DisplayStyle" Style="{StaticResource SelectionCard}" Checked="DisplayStyle_Checked">
                            <StackPanel>
                                <Viewbox Height="64" Margin="0,0,0,2" Stretch="Uniform" IsHitTestVisible="False"><controls:CountdownDisplay x:Name="PreviewClassic" DisplayStyle="Classic" /></Viewbox>
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Klasik}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StyleDigital" Margin="3,0" ToolTip="{DynamicResource Main_SaatDakikaVeSaniye}" GroupName="DisplayStyle" Style="{StaticResource SelectionCard}" Checked="DisplayStyle_Checked">
                            <StackPanel>
                                <Viewbox Height="64" Margin="0,0,0,2" Stretch="Uniform" IsHitTestVisible="False"><controls:CountdownDisplay x:Name="PreviewDigital" DisplayStyle="Digital" Height="150" /></Viewbox>
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Dijital}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StyleMinimal" Margin="3,0,0,0" ToolTip="{DynamicResource Main_BuyukRakamlarVeAltinda}" GroupName="DisplayStyle" Style="{StaticResource SelectionCard}" Checked="DisplayStyle_Checked">
                            <StackPanel>
                                <Viewbox Height="64" Margin="0,0,0,2" Stretch="Uniform" IsHitTestVisible="False"><controls:CountdownDisplay x:Name="PreviewMinimal" DisplayStyle="Minimal" Height="130" /></Viewbox>
                                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource Main_Minimal}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock Margin="4,6,4,0" Style="{StaticResource Caption}" Text="{DynamicResource Main_HemPenceredeHemTam}" />
                    <UniformGrid Margin="0,8,0,0" Columns="2">
                        <ui:Button Margin="0,0,3,0" Height="40" HorizontalAlignment="Stretch" Content="{DynamicResource Main_TamEkrandaOnizle}" Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="{DynamicResource Main_SeciliGostergeStiliniTam}" Click="PreviewFullscreen_Click" />
                        <ui:Button x:Name="PreviewStyleLockButton" Margin="3,0,0,0" Height="40" HorizontalAlignment="Stretch" Content="{DynamicResource Main_KilitEkranindaOnizle}" Icon="{ui:SymbolIcon LockClosed24}" ToolTip="{DynamicResource Main_SeciliGostergeStiliniEkran}" Click="PreviewFullscreen_Click" />
                    </UniformGrid>

                </StackPanel>

                <!-- ======================= TAM EKRAN SEKMESİ ======================= -->
                <StackPanel x:Name="FullscreenPanel">
                    <ui:Button Margin="0,12,0,0" Height="48" HorizontalAlignment="Stretch" Appearance="Primary" FontSize="15" FontWeight="SemiBold" Content="{DynamicResource Main_TamEkraniOnizle}" Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="{DynamicResource Main_AyarlarinSonucunuOrnekBir}" Click="PreviewFullscreen_Click" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_TasarimTamEkranVe}" />
                    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Square24}" ToolTip="{DynamicResource Main_SaatEtiketVeSistem}">
