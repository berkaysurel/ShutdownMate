                            <TextBlock Text="{DynamicResource Main_PencereHerZamanUstte}" />
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PrefAlwaysOnTop" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                    </ui:CardControl>
                    <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main_Animasyonlar}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Main_MenulerinPanellerinVeDugmele}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="PrefAnimations" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                    </ui:CardControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Main_AnaEkran}" />
                    <TextBlock Margin="4,0,4,8" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{DynamicResource Main_AnaEkrandaGormekIstemedigini}" />
                    <StackPanel x:Name="HomeItemsPanel" />

                </StackPanel>

                <!-- ======================= GEÇMİŞ SEKMESİ ======================= -->
                <controls:HistoryView x:Name="HistoryPanel" />

                <!-- ======================= HAKKINDA SEKMESİ ======================= -->
                <controls:AboutView x:Name="AboutPanel" ResetRequested="ResetPreferences_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
