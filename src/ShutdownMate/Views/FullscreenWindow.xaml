<Window
    x:Class="ShutdownMate.Views.FullscreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ShutdownMate.Controls"
    Title="{DynamicResource Full_ShutdownmateTamEkran}"
    Width="800"
    Height="600"
    Background="Black"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <Window.Resources>
        <!-- Kapanış uyarısı her temada koyu karttır: ertele düğmesi temadan bağımsız -->
        <Style x:Key="AlertSecondaryButton" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Karartma modunda Scene saydamlaşır, geriye siyah pencere arka planı kalır. -->
    <Grid x:Name="Scene" SizeChanged="Scene_SizeChanged">

        <!-- ============ Arka plan (ölçeklenmez) ============ -->
        <Grid x:Name="BackgroundLayer" Opacity="0">
            <Rectangle x:Name="SceneBackground" Fill="{DynamicResource ApplicationBackgroundBrush}" />
            <Image x:Name="BackdropImage" Stretch="UniformToFill" Visibility="Collapsed">
                <Image.Effect>
                    <BlurEffect x:Name="BackdropBlur" KernelType="Gaussian" Radius="40" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Rectangle x:Name="BackdropDim" Fill="#99000000" Visibility="Collapsed" />
        </Grid>

        <!-- ============ Kapanış uyarısı karartması (ölçeklenmez) ============ -->
        <Grid x:Name="FinalWash" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <Rectangle Fill="#B3000000" />
        </Grid>

        <!-- ============ Ön plan: 1920x1080 referans, ekrana ölçeklenir ============ -->
        <Grid
            x:Name="ScaleRoot"
            Width="1920"
            Height="1080"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- Normal görünüm -->
            <Grid x:Name="NormalLayer" Margin="64,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Saat ve tarih -->
                <Border x:Name="ClockPanel" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        x:Name="ClockText"
                        FontFamily="Segoe UI Variable Display, Segoe UI"
                        FontSize="40"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Typography.NumeralAlignment="Tabular"
                        Text="00:00" />
                    <TextBlock
                        x:Name="DateText"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                </Border>

                <!-- Girdi kilidi -->
                <Border
                    x:Name="LockPill"
                    Height="44"
                    Padding="16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="LockClosed24" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Full_GirisKilitli}" />
                    </StackPanel>
                </Border>

                <!-- Mesaj, sayaç ve sistem verileri tek grupta: yer yetmezse üçü birlikte küçülür, aralarındaki oran hiç bozulmaz -->
                <Viewbox
                    x:Name="MainGroup"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    StretchDirection="DownOnly">
                    <StackPanel>
                        <!-- Kullanıcının mesajı: ikon kutunun üstünde, yazı dar kutuda ortalı; kutu kart görünümü ayarını izler -->
                        <StackPanel
                            x:Name="MessageCard"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                            <ui:SymbolIcon
                                x:Name="MessageIcon"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Warning24" />
                            <Border
                                MaxWidth="760"
                                Padding="32,14"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    x:Name="MessageText"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Gösterge: ana penceredekiyle aynı denetim; boyutu sabittir -->
                        <!-- Yer dar kalırsa (uzun mesaj, sistem verileri) gösterge sığacak kadar küçülür -->
                        <Viewbox x:Name="HeroViewbox" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
                        <Grid
                            x:Name="HeroBlock"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="HeroScale" ScaleX="0.96" ScaleY="0.96" />
                                    <TranslateTransform x:Name="HeroShift" Y="12" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Ekran kilidinde göstergenin okunması için koyu zemin -->
                            <Border
                                x:Name="HeroBackdrop"
                                Grid.RowSpan="2"
                                Margin="-32,-20"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="Collapsed" />

                            <Viewbox x:Name="StyledBox" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                <controls:CountdownDisplay x:Name="Display" />
                            </Viewbox>

                            <TextBlock
                                x:Name="TargetText"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                TextAlignment="Center" />
                        </Grid>
                        </Viewbox>

                        <!-- Sistem verileri (isteğe bağlı) -->
                        <UniformGrid x:Name="MetricsPanel" Width="1600" Margin="0,40,0,0" Rows="1" Visibility="Collapsed">
                            <controls:MetricTile x:Name="CpuTile" Margin="6,0" />
                            <controls:MetricTile x:Name="GpuTile" Margin="6,0" />
                            <controls:MetricTile x:Name="DownloadTile" Margin="6,0" />
                            <controls:MetricTile x:Name="UploadTile" Margin="6,0" />
                            <controls:MetricTile x:Name="TransferTile" Margin="6,0" />
                        </UniformGrid>

                    </StackPanel>
                </Viewbox>

                <!-- İşler bitince çipleri ya da durum satırı -->
                <Grid
                    x:Name="BottomCenter"
                    Grid.Row="4"
                    MinHeight="44"
                    MaxWidth="1200"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center">
                    <StackPanel
                        x:Name="ChipsPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- Ekran kilidi: arkadaki ekranı kapatmayan küçük sayaç -->
                <Border
                    x:Name="LockStatusCard"
                    Grid.Row="4"
                    Width="380"
                    Margin="0,12,0,0"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="LockTimeText"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Typography.NumeralAlignment="Tabular" />
                        <TextBlock
                            x:Name="LockTargetText"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Basılı tutarak çıkış: alt orta, her zaman görünür -->
                <StackPanel
                    x:Name="ExitPanel"
                    Grid.Row="5"
                    Margin="0,12,0,20"
                    HorizontalAlignment="Center">
                    <Grid
                        x:Name="ExitButton"
                        Width="480"
                        Height="76"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseEnter="ExitButton_MouseEnter"
                        MouseLeave="ExitButton_MouseLeave"
                        MouseLeftButtonDown="ExitButton_MouseDown"
                        MouseLeftButtonUp="ExitButton_MouseUp">
                        <Rectangle
                            x:Name="ExitCircle"
                            Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{DynamicResource CardStrokeColorDefaultBrush}"
                            StrokeThickness="1" />
                        <!-- Basılı tutarken kart soldan sağa dolar -->
                        <Border
                            x:Name="ExitFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8"
                            IsHitTestVisible="False"
                            Opacity="0.6" />
                        <Grid Margin="18,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40">
                                <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="2" />
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Symbol="Dismiss24" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ExitTitleText" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="ExitHintText" Margin="0,2,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource Full_Esc}" />
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Kapanış uyarısı: uygulamanın onay penceresiyle aynı kart düzeni -->
            <Grid x:Name="FinalLayer" Visibility="Collapsed">
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="72,48"
                    Background="#F2202020"
                    BorderBrush="#FF99A4"
                    BorderThickness="2"
                    CornerRadius="12">
                    <StackPanel
                        x:Name="FinalContent"
                        RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="FinalScale" ScaleX="1" ScaleY="1" />
                        </StackPanel.RenderTransform>

                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Foreground="#FF99A4"
                            Symbol="AlertUrgent24" />
                        <TextBlock
                            x:Name="FinalHeadlineText"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Foreground="White"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="FinalDetailText"
                            MaxWidth="760"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            Foreground="#C8FFFFFF"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <!-- Halka -->
                        <Grid
                            Width="320"
                            Height="320"
                            Margin="0,32,0,0"
                            HorizontalAlignment="Center">
                            <ui:Arc
                                Width="320"
                                Height="320"
                                EndAngle="359.9"
                                StartAngle="0"
                                Stroke="#1FFFFFFF"
                                StrokeThickness="10" />
                            <ui:Arc
                                x:Name="FinalRing"
                                Width="320"
                                Height="320"
                                EndAngle="359.9"
                                StartAngle="0"
                                Stroke="#FF99A4"
                                StrokeThickness="10" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="FinalSecondsText"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="140"
                                    FontWeight="Light"
                                    Foreground="White"
                                    RenderTransformOrigin="0.5,0.5"
                                    Typography.NumeralAlignment="Tabular"
                                    Text="30">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="FinalNumberScale" ScaleX="1" ScaleY="1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock
                                    x:Name="FinalSecondsLabel"
                                    Margin="0,-12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    Foreground="#C8FFFFFF"
                                    Text="{DynamicResource Full_Saniye}" />
                            </StackPanel>
                        </Grid>

                        <!-- "Bilgisayar kullanılıyorsa işlem yapma" açıkken: ertelemenin nedeni ve elle işlem -->
                        <Border
                            x:Name="ActiveNotice"
                            Width="616"
                            Margin="0,32,0,0"
                            Padding="16,12"
                            Background="#14FFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Foreground="White"
                                    Symbol="Info24" />
                                <TextBlock
                                    x:Name="ActiveNoticeText"
                                    Grid.Column="1"
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Foreground="White"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="NowButton"
                                    Grid.Column="2"
                                    Height="44"
                                    MinWidth="150"
                                    VerticalAlignment="Center"
                                    Click="NowButton_Click"
                                    Content="{DynamicResource Full_SimdiKapat}"
                                    FontSize="15"
                                    Style="{StaticResource AlertSecondaryButton}" />
                            </Grid>
                        </Border>

                        <!-- Elle işlem için ikinci onay; açıkken alttaki düğmelerin yerini alır -->
                        <StackPanel
                            x:Name="ConfirmPanel"
                            Width="616"
                            Margin="0,32,0,0"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ConfirmText"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                Foreground="White"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <UniformGrid Margin="0,16,0,0" Rows="1">
                                <Button
                                    x:Name="ConfirmYesButton"
                                    Height="68"
                                    Margin="0,0,8,0"
                                    Click="ConfirmYesButton_Click"
                                    Content="{DynamicResource Full_EvetSimdiKapat}"
                                    FontSize="20"
                                    Style="{StaticResource DangerButton}" />
                                <Button
                                    x:Name="ConfirmNoButton"
                                    Height="68"
                                    Margin="8,0,0,0"
                                    Click="ConfirmNoButton_Click"
                                    Content="{DynamicResource Full_Vazgec}"
                                    Style="{StaticResource AlertSecondaryButton}" />
                            </UniformGrid>
                        </StackPanel>

                        <!-- Düğmeler -->
                        <UniformGrid
                            x:Name="FinalButtons"
                            Margin="0,32,0,0"
                            Rows="1">
                            <UniformGrid.RenderTransform>
                                <TranslateTransform x:Name="FinalButtonsShift" Y="0" />
                            </UniformGrid.RenderTransform>
                            <Button
                                x:Name="CancelButton"
                                Height="68"
                                MinWidth="300"
                                Margin="0,0,8,0"
                                FontSize="20"
                                Click="CancelButton_Click"
                                Content="{DynamicResource Full_IptalEt}"
                                IsDefault="True"
                                Style="{StaticResource DangerButton}" />
                            <Button
                                x:Name="SnoozeButton"
                                Height="68"
                                MinWidth="300"
                                Margin="8,0,0,0"
                                Click="SnoozeButton_Click"
                                Content="{DynamicResource Full_10DkErtele}"
                                Style="{StaticResource AlertSecondaryButton}" />
                        </UniformGrid>
                        <TextBlock
                            x:Name="KeyHintText"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            Foreground="#C8FFFFFF"
                            Text="{DynamicResource Full_KlavyedenEnterYaDa}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
