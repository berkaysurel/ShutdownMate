<ui:FluentWindow
    x:Class="ShutdownMate.Views.AppDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="480"
    MinHeight="0"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Border x:Name="DialogRoot" VerticalAlignment="Top" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>

            <!-- İçerik: her şey ortalı -->
            <StackPanel Margin="32,28,32,24">
                <ui:SymbolIcon x:Name="KindIcon" HorizontalAlignment="Center" FontSize="36" />
                <TextBlock x:Name="TitleText" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />

                <!-- Öne çıkan bilgi (ör. işlemin kendisi ve saati) -->
                <Border x:Name="HighlightBox" Margin="0,16,0,0" Padding="16,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <TextBlock x:Name="HighlightText" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="MessageText" Margin="0,12,0,0" FontSize="15" LineHeight="22" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="NoteText" Margin="0,14,0,0" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
            </StackPanel>

            <!-- Düğmeler: eşit genişlikte -->
            <Border Padding="24,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <UniformGrid x:Name="ButtonRow" Rows="1">
                    <ui:Button x:Name="SecondaryButton" Height="44" Margin="0,0,4,0" HorizontalAlignment="Stretch" FontSize="15" Click="SecondaryButton_Click" />
                    <ui:Button x:Name="PrimaryButton" Height="44" Margin="4,0,0,0" HorizontalAlignment="Stretch" FontSize="15" FontWeight="SemiBold" Appearance="Primary" Click="PrimaryButton_Click" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</ui:FluentWindow>
