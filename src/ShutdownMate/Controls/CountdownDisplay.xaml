<UserControl
    x:Class="ShutdownMate.Controls.CountdownDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="320"
    Height="320">

    <!-- Tasarım boyutu 320x320; büyütmek için bir Viewbox içine konur. -->
    <Grid>

        <!-- ===================== MODERN ===================== -->
        <Grid x:Name="ModernView">
            <ui:Arc Margin="12" StartAngle="0" EndAngle="359.9" StrokeThickness="8" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <ui:Arc x:Name="ModernArc" Margin="12" StartAngle="0" EndAngle="359.9" StrokeThickness="8" Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon x:Name="ModernIcon" HorizontalAlignment="Center" FontSize="24" Symbol="Power24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ModernText" Margin="0,6,0,0" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="52" FontWeight="Light" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="00:00:00" />
                <TextBlock x:Name="ModernCaption" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource Count_Kalan}" />
            </StackPanel>
        </Grid>

        <!-- ===================== KLASİK: sade kadran, on iki çizgi, ince yelkovan ===================== -->
        <Grid x:Name="ClassicView" Visibility="Collapsed">
            <Ellipse Width="240" Height="240" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="4" />
            <ui:Arc x:Name="ClassicArc" Width="240" Height="240" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" StartAngle="0" EndAngle="359.9" StrokeThickness="4" Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
            <Canvas x:Name="ClassicTicks" Width="320" Height="320" />
            <Line
                x:Name="ClassicHand"
                X1="160" Y1="124" X2="160" Y2="40"
                Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="3">
                <Line.RenderTransform>
                    <RotateTransform x:Name="ClassicHandRotation" CenterX="160" CenterY="124" />
                </Line.RenderTransform>
            </Line>
            <Ellipse Width="14" Height="14" Margin="0,117,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="3" />

            <!-- Süre kadranın altında: yelkovan rakamların üstünden geçmez -->
            <StackPanel Margin="0,250,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock x:Name="ClassicText" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36" FontWeight="Light" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="00:00:00" />
                <TextBlock x:Name="ClassicCaption" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource Count_Kalan}" />
            </StackPanel>
        </Grid>

        <!-- ===================== DİJİTAL: retro yedi segmentli LED rakamlar, koyu panel, sönük segmentler ve parıltı ===================== -->
        <Grid x:Name="DigitalView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <Border x:Name="DigitalBoxes" Width="300" Padding="18,14" CornerRadius="10" BorderThickness="1" Background="#0E0E0E" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Viewbox Stretch="Uniform">
                        <Grid>
                            <TextBlock x:Name="DigitalGhost" FontFamily="pack://application:,,,/ShutdownMate;component/Assets/Fonts/#DSEG7 Classic" FontWeight="Bold" FontSize="48" Foreground="#16FFB000" Text="88:88:88" />
                            <TextBlock x:Name="DigitalText" FontFamily="pack://application:,,,/ShutdownMate;component/Assets/Fonts/#DSEG7 Classic" FontWeight="Bold" FontSize="48" Foreground="#FFFFB000" Text="00:00:00">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="DigitalGlow" Color="#FFB000" BlurRadius="14" ShadowDepth="0" Opacity="0.75" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Viewbox>
                </Border>
                <!-- Süre biçiminde olmayan metinler (ör. "Bekleniyor") yedi segmentle yazılamaz; düz yazı tipiyle gösterilir -->
                <TextBlock x:Name="DigitalPlain" Visibility="Collapsed" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" FontWeight="Light" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Grid x:Name="DigitalBarHost" Width="300" Height="4" Margin="0,16,0,10">
                    <Rectangle Fill="{DynamicResource ControlStrokeColorDefaultBrush}" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="DigitalBar" HorizontalAlignment="Left" Width="0" Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" />
                </Grid>
                <TextBlock x:Name="DigitalCaption" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource Count_Kalan}" />
            </StackPanel>
        </Grid>

        <!-- ===================== MİNİMAL ===================== -->
        <Grid x:Name="MinimalView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MinimalText" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="68" FontWeight="Light" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="00:00:00" />
                <Grid x:Name="MinimalBarHost" Width="250" Height="4" Margin="0,12,0,12">
                    <Rectangle Fill="{DynamicResource ControlStrokeColorDefaultBrush}" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="MinimalBar" HorizontalAlignment="Left" Width="0" Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" />
                </Grid>
                <TextBlock x:Name="MinimalCaption" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{DynamicResource Count_Kalan}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
