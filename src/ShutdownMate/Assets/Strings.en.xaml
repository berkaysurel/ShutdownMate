    <sys:String x:Key="History_250Mb">250 MB</sys:String>
    <sys:String x:Key="History_500Mb">500 MB</sys:String>
    <sys:String x:Key="History_1Gb">1 GB</sys:String>
    <sys:String x:Key="History_2Gb">2 GB</sys:String>
    <sys:String x:Key="History_WindowsHataKayitlariniEkle">Include Windows error logs</sys:String>
    <sys:String x:Key="History_BuSuredekiProgramCokmeleri">Adds program crashes and driver or disk errors from this period. Names of other programs and error texts may be visible.</sys:String>
    <sys:String x:Key="History_KayitKlasorunuAc">Open recording folder</sys:String>
    <sys:String x:Key="History_GozetimKayitlarininVeEkran">Opens the folder that holds watch recordings and screenshots (%APPDATA%\ShutdownMate\Gecmis)</sys:String>
    <sys:String x:Key="History_KayitlariSil">Delete recordings</sys:String>
    <sys:String x:Key="History_TumGozetimKayitlariniVe">Deletes all watch recordings and screenshots; the history list stays. You are asked first and it cannot be undone.</sys:String>
    <sys:String x:Key="LockMsg_EkrandaGorunecekMesajiYazin">Type the message to show on screen</sys:String>
    <sys:String x:Key="LockMsg_HazirMesajlar">Preset messages</sys:String>
    <sys:String x:Key="LockMsg_HazirBirMesajSecin">Pick a preset message; it replaces the text in the box. The list is edited in Settings &gt; Screen lock.</sys:String>
    <sys:String x:Key="LockPreset_BuradaYazilanlarEkranaDogrud">What you write here does not go straight to the screen; it only appears in the Preset messages list on the main screen.</sys:String>
    <sys:String x:Key="LockPreset_MesajEkle">Add message</sys:String>
    <sys:String x:Key="LockPreset_ListeyeYeniBirHazir">Adds a new preset message to the list (up to 12)</sys:String>
